#!/system/bin/sh
# sqlite3-tool — helper commands for SQLite on Android ARM64
# Part of nikakvo/sqlite3-android-arm64-only
# Usage: sqlite3-tool <command> [args...]

VERSION="2.0"

# Overridable so the script can be tested against any sqlite3 build.
SQLITE3="${SQLITE3_BIN:-/system/bin/sqlite3.real}"
[ -x "$SQLITE3" ] || SQLITE3="${0%/*}/sqlite3.real"
[ -x "$SQLITE3" ] || SQLITE3="sqlite3"

# Every call gets a busy timeout. Without it, touching any live system
# database returns "database is locked" immediately instead of waiting.
BUSY_MS="${SQLITE3_BUSY_MS:-5000}"

# ── Colours ───────────────────────────────────────────────────────────────────
# The old check called tput, which does not exist on Android — the test always
# failed and colours were silently dead. TERM is what actually works here.
case "${TERM:-dumb}" in
    dumb | unknown | '') COLOR=0 ;;
    *) [ -t 1 ] && COLOR=1 || COLOR=0 ;;
esac
[ -z "${NO_COLOR:-}" ] || COLOR=0

if [ "$COLOR" = "1" ]; then
    R='\033[0;31m'; G='\033[0;32m'; C='\033[0;36m'; W='\033[1;37m'; N='\033[0m'
else
    R=''; G=''; C=''; W=''; N=''
fi

err()  { printf "${R}Error:${N} %s\n" "$*" >&2; }
ok()   { printf "${G}OK:${N}    %s\n" "$*"; }
info() { printf "${C}Info:${N}  %s\n" "$*"; }

# ── SQLite helpers ────────────────────────────────────────────────────────────
# sq <db> <sql...> — run SQL against a database with a busy timeout set.
sq() {
    _db="$1"
    shift
    "$SQLITE3" -cmd ".output /dev/null" \
               -cmd "PRAGMA busy_timeout=$BUSY_MS;" \
               -cmd ".output stdout" \
               "$_db" "$@" 2>/dev/null
}

# Quote an SQL identifier: wrap in double quotes and double any inside.
qident() { printf '"%s"' "$(printf '%s' "$1" | sed 's/"/""/g')"; }

# Quote an SQL string literal.
qstr() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }

human() { # bytes -> human readable, integer math only
    _b="$1"
    case "$_b" in
        '' | *[!0-9]*) printf '?' ; return ;;
    esac
    if   [ "$_b" -lt 1024 ]; then printf '%s B' "$_b"
    elif [ "$_b" -lt 1048576 ]; then printf '%s KB' "$(( _b / 1024 ))"
    elif [ "$_b" -lt 1073741824 ]; then printf '%s MB' "$(( _b / 1048576 ))"
    else printf '%s.%s GB' "$(( _b / 1073741824 ))" "$(( (_b % 1073741824) * 10 / 1073741824 ))"
    fi
}

file_size() {
    _fs=$(wc -c < "$1" 2>/dev/null | tr -d ' \t')
    case "$_fs" in
        '' | *[!0-9]*) printf '0' ;;
        *) printf '%s' "$_fs" ;;
    esac
}

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
cat << EOF

${W}sqlite3-tool v${VERSION}${N} — SQLite helper for Android ARM64

${W}Usage:${N}
  sqlite3-tool <command> [database] [args]

${W}Inspect:${N}
  ${G}info${N}            <db>              Quick database summary
  ${G}tables${N}          <db>              List all tables with row counts
  ${G}indexes${N}         <db>              List all indexes
  ${G}schema${N}          <db> [table]      Show CREATE statements
  ${G}size${N}            <db>              Page stats and file size
  ${G}biggest${N}         <db> [n]          Largest tables/indexes on disk (dbstat)
  ${G}doctor${N}          <db>              Run sqlite3-doctor (full diagnostics)

${W}Maintain:${N}
  ${G}integrity${N}       <db>              PRAGMA integrity_check
  ${G}vacuum${N}          <db>              VACUUM (defragment + shrink)
  ${G}analyze${N}         <db>              ANALYZE (update query planner stats)
  ${G}optimize${N}        <db>              PRAGMA optimize
  ${G}wal-checkpoint${N}  <db>              PRAGMA wal_checkpoint(FULL)

${W}Move data:${N}
  ${G}backup${N}          <db> <dest>       Online backup (safe on a live database)
  ${G}restore${N}         <backup> <dest>   Restore from a backup

${W}Build:${N}
  ${G}compile-options${N} [filter]          Show how this sqlite3 was compiled
  ${G}version${N}                           sqlite3-tool and SQLite versions

${W}Environment:${N}
  SQLITE3_BIN       path to the sqlite3 binary (default /system/bin/sqlite3.real)
  SQLITE3_BUSY_MS   busy timeout in ms (default 5000)

${W}Examples:${N}
  sqlite3-tool info /data/data/com.example/databases/app.db
  sqlite3-tool backup /data/data/com.example/databases/app.db /sdcard/app.db
  sqlite3-tool biggest /sdcard/big.db 10
  sqlite3-tool compile-options FTS

EOF
    exit 0
}

[ $# -eq 0 ] && usage
case "$1" in
    -h | --help | help) usage ;;
esac

CMD="$1"
DB="$2"
ARG3="$3"

need_db() {
    [ -n "$DB" ] || { err "No database specified. Usage: sqlite3-tool $CMD <database>"; exit 1; }
    [ -f "$DB" ] || { err "File not found: $DB"; exit 1; }
    [ -r "$DB" ] || { err "No read permission: $DB — try: su -c 'sqlite3-tool $CMD $DB'"; exit 1; }
}

need_writable() {
    [ -w "$DB" ] || { err "No write permission: $DB"; exit 1; }
}

# ── Inspect ───────────────────────────────────────────────────────────────────
cmd_info() {
    need_db
    printf "\n${W}[ %s ]${N}\n\n" "$DB"
    info "SQLite version:  $("$SQLITE3" --version 2>/dev/null | cut -d' ' -f1)"
    info "Journal mode:    $(sq "$DB" 'PRAGMA journal_mode;')"
    info "Page size:       $(sq "$DB" 'PRAGMA page_size;') bytes"
    info "Encoding:        $(sq "$DB" 'PRAGMA encoding;')"
    info "Auto vacuum:     $(sq "$DB" 'PRAGMA auto_vacuum;')"
    info "User version:    $(sq "$DB" 'PRAGMA user_version;')"
    info "Foreign keys:    $(sq "$DB" 'PRAGMA foreign_keys;')"
    info "WAL file:        $([ -f "${DB}-wal" ] && echo YES || echo no)"
    printf "\n"
    info "Tables:          $(sq "$DB" "SELECT count(*) FROM sqlite_master WHERE type='table';")"
    info "Indexes:         $(sq "$DB" "SELECT count(*) FROM sqlite_master WHERE type='index';")"
    info "File size:       $(human "$(file_size "$DB")")"
    printf "\n"
}

cmd_tables() {
    need_db
    info "Tables in: $DB"
    printf "\n"
    sq "$DB" "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;" |
    while IFS= read -r t; do
        [ -n "$t" ] || continue
        COUNT=$(sq "$DB" "SELECT count(*) FROM $(qident "$t");")
        printf "  %-40s %s rows\n" "$t" "${COUNT:-?}"
    done
    printf "\n"
}

cmd_indexes() {
    need_db
    info "Indexes in: $DB"
    printf "\n"
    sq "$DB" "SELECT name, tbl_name FROM sqlite_master WHERE type='index' ORDER BY tbl_name, name;" |
    while IFS='|' read -r idx tbl; do
        [ -n "$idx" ] || continue
        printf "  %-40s -> %s\n" "$idx" "$tbl"
    done
    printf "\n"
}

cmd_schema() {
    need_db
    if [ -n "$ARG3" ]; then
        info "Schema for '$ARG3' in: $DB"
        sq "$DB" "SELECT sql FROM sqlite_master WHERE name=$(qstr "$ARG3");"
    else
        info "Full schema for: $DB"
        sq "$DB" "SELECT sql FROM sqlite_master WHERE sql IS NOT NULL ORDER BY type, name;"
    fi
}

cmd_size() {
    need_db
    PAGE_SIZE=$(sq "$DB" 'PRAGMA page_size;')
    PAGE_COUNT=$(sq "$DB" 'PRAGMA page_count;')
    FREELIST=$(sq "$DB" 'PRAGMA freelist_count;')
    printf "\n"
    info "File:          $DB"
    info "File size:     $(human "$(file_size "$DB")")"
    info "Page size:     ${PAGE_SIZE} bytes"
    info "Page count:    ${PAGE_COUNT}"
    info "Freelist:      ${FREELIST} pages"
    [ -f "${DB}-wal" ] && info "WAL size:      $(human "$(file_size "${DB}-wal")")"
    [ -f "${DB}-shm" ] && info "SHM present:   yes"
    printf "\n"
}

# Replaces the sqlite3_analyzer tool, which needs TCL to build and was never
# shipped. dbstat gives the same per-object page accounting.
cmd_biggest() {
    need_db
    LIMIT="${ARG3:-10}"
    case "$LIMIT" in
        '' | *[!0-9]*) LIMIT=10 ;;
    esac
    info "Largest objects in: $DB (top $LIMIT, via dbstat)"
    printf "\n"
    printf "  %-38s %10s %10s\n" "NAME" "PAGES" "SIZE"
    printf "  %-38s %10s %10s\n" "──────────────────────────────────────" "──────────" "──────────"
    OUT=$(sq "$DB" "SELECT name, sum(pgsize), count(*) FROM dbstat GROUP BY name ORDER BY sum(pgsize) DESC LIMIT $LIMIT;")
    if [ -z "$OUT" ]; then
        err "dbstat is unavailable — this sqlite3 was built without SQLITE_ENABLE_DBSTAT_VTAB"
        exit 1
    fi
    printf '%s\n' "$OUT" | while IFS='|' read -r name bytes pages; do
        [ -n "$name" ] || continue
        printf "  %-38s %10s %10s\n" "$name" "$pages" "$(human "$bytes")"
    done
    printf "\n"
}

# ── Maintain ──────────────────────────────────────────────────────────────────
cmd_integrity() {
    need_db
    info "Running integrity_check on: $DB"
    RESULT=$(sq "$DB" 'PRAGMA integrity_check;')
    if [ "$RESULT" = "ok" ]; then
        ok "integrity_check passed"
    else
        err "integrity_check FAILED:"
        printf '%s\n' "$RESULT"
        exit 1
    fi
}

cmd_vacuum() {
    need_db
    need_writable
    BEFORE=$(file_size "$DB")
    info "Running VACUUM on: $DB (was $(human "$BEFORE"))"
    sq "$DB" "VACUUM;" || { err "VACUUM failed"; exit 1; }
    AFTER=$(file_size "$DB")
    ok "VACUUM complete — $(human "$BEFORE") -> $(human "$AFTER")"
}

cmd_analyze() {
    need_db
    need_writable
    info "Running ANALYZE on: $DB"
    sq "$DB" "ANALYZE;" && ok "ANALYZE complete"
}

cmd_optimize() {
    need_db
    need_writable
    info "Running PRAGMA optimize on: $DB"
    sq "$DB" "PRAGMA analysis_limit=1000; PRAGMA optimize;" && ok "optimize complete"
}

cmd_wal_checkpoint() {
    need_db
    need_writable
    info "Running WAL checkpoint on: $DB"
    RESULT=$(sq "$DB" 'PRAGMA wal_checkpoint(FULL);')
    ok "wal_checkpoint result: $RESULT"
    if [ -f "${DB}-wal" ]; then
        info "WAL file still present (another connection may be holding it)"
    else
        ok "WAL file is gone"
    fi
}

# ── Move data ─────────────────────────────────────────────────────────────────
cmd_backup() {
    need_db
    [ -n "$ARG3" ] || { err "Usage: sqlite3-tool backup <source> <destination>"; exit 1; }
    DEST="$ARG3"
    info "Backing up: $DB -> $DEST"

    # The old version ran a checkpoint and then plain cp. That writes to the
    # source (fails on a read-only database) and is not atomic — a writer
    # during the copy produces a corrupt backup. .backup uses SQLite's online
    # backup API, which is safe on a live database and needs no write access.
    rm -f "$DEST" "${DEST}-wal" "${DEST}-shm" 2>/dev/null

    if ! "$SQLITE3" -cmd ".output /dev/null" \
                    -cmd "PRAGMA busy_timeout=$BUSY_MS;" \
                    -cmd ".output stdout" \
                    "$DB" ".backup $(qstr "$DEST")"; then
        err "Backup failed"
        exit 1
    fi

    [ -f "$DEST" ] || { err "Backup produced no file"; exit 1; }
    VERIFY=$(sq "$DEST" 'PRAGMA integrity_check;')
    if [ "$VERIFY" != "ok" ]; then
        err "Backup failed its own integrity check — not trusting it"
        exit 1
    fi
    ok "Backup complete and verified -> $DEST ($(human "$(file_size "$DEST")"))"
}

cmd_restore() {
    [ -n "$DB" ]   || { err "Usage: sqlite3-tool restore <backup> <destination>"; exit 1; }
    [ -n "$ARG3" ] || { err "Usage: sqlite3-tool restore <backup> <destination>"; exit 1; }
    SRC="$DB"
    DEST="$ARG3"
    [ -f "$SRC" ] || { err "Backup file not found: $SRC"; exit 1; }

    info "Restoring: $SRC -> $DEST"

    INTEGRITY=$(sq "$SRC" 'PRAGMA integrity_check;')
    if [ "$INTEGRITY" != "ok" ]; then
        err "Source backup failed integrity check — aborting restore"
        exit 1
    fi

    cp "$SRC" "$DEST" || { err "Restore copy failed"; exit 1; }

    # Stale sidecar files next to the destination would be replayed against
    # the restored database, or worse, treated as live shared memory. The old
    # version copied them across from the backup; they must be removed.
    rm -f "${DEST}-wal" "${DEST}-shm" 2>/dev/null

    ok "Restore complete -> $DEST"
}

# ── Build info ────────────────────────────────────────────────────────────────
cmd_compile_options() {
    FILTER="$DB"
    OUT=$("$SQLITE3" ":memory:" "PRAGMA compile_options;" 2>/dev/null)
    if [ -n "$FILTER" ]; then
        printf '%s\n' "$OUT" | grep -i -- "$FILTER" || { err "No compile option matches: $FILTER"; exit 1; }
    else
        printf '%s\n' "$OUT"
    fi
}

cmd_version() {
    printf "sqlite3-tool  v%s\n" "$VERSION"
    printf "sqlite3       %s\n" "$("$SQLITE3" --version 2>/dev/null)"
    printf "binary        %s\n" "$SQLITE3"
}

cmd_doctor() {
    need_db
    if command -v sqlite3-doctor >/dev/null 2>&1; then
        sqlite3-doctor "$DB"
    elif [ -x "${0%/*}/sqlite3-doctor" ]; then
        "${0%/*}/sqlite3-doctor" "$DB"
    else
        err "sqlite3-doctor not found"
        exit 1
    fi
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
case "$CMD" in
    info)            cmd_info ;;
    tables)          cmd_tables ;;
    indexes)         cmd_indexes ;;
    schema)          cmd_schema ;;
    size)            cmd_size ;;
    biggest)         cmd_biggest ;;
    integrity)       cmd_integrity ;;
    vacuum)          cmd_vacuum ;;
    analyze)         cmd_analyze ;;
    optimize)        cmd_optimize ;;
    wal-checkpoint)  cmd_wal_checkpoint ;;
    backup)          cmd_backup ;;
    restore)         cmd_restore ;;
    compile-options) cmd_compile_options ;;
    version)         cmd_version ;;
    doctor)          cmd_doctor ;;
    *)
        err "Unknown command: $CMD"
        printf "Run 'sqlite3-tool --help' for usage.\n"
        exit 1
        ;;
esac
