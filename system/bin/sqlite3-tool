#!/system/bin/sh
# sqlite3-tool — helper commands for SQLite on Android ARM64
# Part of nikakvo/sqlite3-android-arm64-only
# Usage: sqlite3-tool <command> [args...]

VERSION="2.2"

# Overridable so the script can be tested against any sqlite3 build.
SQLITE3="${SQLITE3_BIN:-/system/bin/sqlite3.real}"
[ -x "$SQLITE3" ] || SQLITE3="${0%/*}/sqlite3.real"
[ -x "$SQLITE3" ] || SQLITE3="sqlite3"

# Every call gets a busy timeout. Without it, touching any live system
# database returns "database is locked" immediately instead of waiting.
BUSY_MS="${SQLITE3_BUSY_MS:-5000}"

# ── Colours ───────────────────────────────────────────────────────────────────
# The old check called tput, which does not exist on Android — the test always
# failed and colours were silently dead. TERM is what actually works here.
case "${TERM:-dumb}" in
    dumb | unknown | '') COLOR=0 ;;
    *) [ -t 1 ] && COLOR=1 || COLOR=0 ;;
esac
[ -z "${NO_COLOR:-}" ] || COLOR=0

# Real ESC bytes, not the text "\033": usage() prints through cat, which does
# not interpret escapes, so the old values showed up literally in --help.
if [ "$COLOR" = "1" ]; then
    E=$(printf '\033')
    R="${E}[0;31m"; G="${E}[0;32m"; Y="${E}[0;33m"; C="${E}[0;36m"; W="${E}[1;37m"; N="${E}[0m"
else
    R=''; G=''; Y=''; C=''; W=''; N=''
fi

err()  { printf "${R}Error:${N} %s\n" "$*" >&2; }
warn() { printf "${Y}Warn:${N}  %s\n" "$*"; }
ok()   { printf "${G}OK:${N}    %s\n" "$*"; }
info() { printf "${C}Info:${N}  %s\n" "$*"; }

# ── SQLite helpers ────────────────────────────────────────────────────────────
# sq <db> <sql...> — run SQL against a database with a busy timeout set.
sq() {
    _db="$1"
    shift
    "$SQLITE3" -cmd ".output /dev/null" \
               -cmd "PRAGMA busy_timeout=$BUSY_MS;" \
               -cmd ".output stdout" \
               "$_db" "$@" 2>/dev/null
}

# sqw <db> <sql...> — for commands that change the database. SQLite's own
# error message ("database is locked", "disk I/O error", ...) stays visible;
# sq hides it, which left a bare "VACUUM failed" with no reason.
sqw() {
    _db="$1"
    shift
    "$SQLITE3" -cmd ".output /dev/null" \
               -cmd "PRAGMA busy_timeout=$BUSY_MS;" \
               -cmd ".output stdout" \
               "$_db" "$@"
}

# Quote an SQL identifier: wrap in double quotes and double any inside.
qident() { printf '"%s"' "$(printf '%s' "$1" | sed 's/"/""/g')"; }

# Quote an SQL string literal.
qstr() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }

# Quote an argument for a dot-command (.backup, .restore). The shell does not
# understand SQL-style '' inside dot-command arguments; it uses double quotes
# with backslash escapes instead.
qdot() { printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"; }

human() { # bytes -> human readable, integer math only
    _b="$1"
    case "$_b" in
        '' | *[!0-9]*) printf '?' ; return ;;
    esac
    if   [ "$_b" -lt 1024 ]; then printf '%s B' "$_b"
    elif [ "$_b" -lt 1048576 ]; then printf '%s KB' "$(( _b / 1024 ))"
    elif [ "$_b" -lt 1073741824 ]; then printf '%s MB' "$(( _b / 1048576 ))"
    else printf '%s.%s GB' "$(( _b / 1073741824 ))" "$(( (_b % 1073741824) * 10 / 1073741824 ))"
    fi
}

file_size() {
    _fs=$(wc -c < "$1" 2>/dev/null | tr -d ' \t')
    case "$_fs" in
        '' | *[!0-9]*) printf '0' ;;
        *) printf '%s' "$_fs" ;;
    esac
}

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
cat << EOF

${W}sqlite3-tool v${VERSION}${N} — SQLite helper for Android ARM64

${W}Usage:${N}
  sqlite3-tool <command> [database] [args]

${W}Inspect:${N}
  ${G}info${N}            <db>              Quick database summary
  ${G}tables${N}          <db>              List all tables with row counts
  ${G}indexes${N}         <db>              List all indexes
  ${G}schema${N}          <db> [table]      Show CREATE statements
  ${G}size${N}            <db>              Page stats and file size
  ${G}biggest${N}         <db> [n]          Largest tables/indexes on disk (dbstat)
  ${G}doctor${N}          <db>              Run sqlite3-doctor (full diagnostics)

${W}Maintain:${N}
  ${G}integrity${N}       <db>              PRAGMA integrity_check
  ${G}vacuum${N}          <db>              VACUUM (defragment + shrink)
  ${G}analyze${N}         <db>              ANALYZE (update query planner stats)
  ${G}optimize${N}        <db>              PRAGMA optimize
  ${G}wal-checkpoint${N}  <db>              PRAGMA wal_checkpoint(FULL)

${W}Move data:${N}
  ${G}backup${N}          <db> <dest>       Online backup (safe on a live database)
  ${G}restore${N}         <backup> <dest>   Restore from a backup

${W}Build:${N}
  ${G}compile-options${N} [filter]          Show how this sqlite3 was compiled
  ${G}version${N}                           sqlite3-tool and SQLite versions

${W}Environment:${N}
  SQLITE3_BIN       path to the sqlite3 binary (default /system/bin/sqlite3.real)
  SQLITE3_BUSY_MS   busy timeout in ms (default 5000)

${W}Examples:${N}
  sqlite3-tool info /data/data/com.example/databases/app.db
  sqlite3-tool backup /data/data/com.example/databases/app.db /sdcard/app.db
  sqlite3-tool biggest /sdcard/big.db 10
  sqlite3-tool compile-options FTS

EOF
    exit 0
}

[ $# -eq 0 ] && usage
case "$1" in
    -h | --help | help) usage ;;
esac

CMD="$1"
DB="$2"
ARG3="$3"
# A path starting with "-" would be read as an option by head and sqlite3.
case "$CMD" in
    compile-options | version) ;;
    *) case "$DB" in -*) DB="./$DB" ;; esac ;;
esac
case "$CMD" in
    backup | restore) case "$ARG3" in -*) ARG3="./$ARG3" ;; esac ;;
esac

need_db() {
    [ -n "$DB" ] || { err "No database specified. Usage: sqlite3-tool $CMD <database>"; exit 1; }
    [ -f "$DB" ] || { err "File not found: $DB"; exit 1; }
    [ -r "$DB" ] || { err "No read permission: $DB — try: su -c 'sqlite3-tool $CMD $DB'"; exit 1; }
    # Every query below hides SQLite's stderr, so a file that is not a database
    # used to produce empty fields instead of an error. A 0-byte file is fine:
    # SQLite treats it as a new, empty database.
    if [ "$(file_size "$DB")" -gt 0 ] && [ "$(head -c 15 "$DB" 2>/dev/null)" != "SQLite format 3" ]; then
        err "Not an SQLite 3 database (or it is encrypted): $DB"
        exit 1
    fi
}

need_writable() {
    [ -w "$DB" ] || { err "No write permission: $DB"; exit 1; }
}

# ── Inspect ───────────────────────────────────────────────────────────────────
cmd_info() {
    need_db
    printf "\n${W}[ %s ]${N}\n\n" "$DB"
    info "SQLite version:  $("$SQLITE3" --version 2>/dev/null | cut -d' ' -f1)"
    info "Journal mode:    $(sq "$DB" 'PRAGMA journal_mode;')"
    info "Page size:       $(sq "$DB" 'PRAGMA page_size;') bytes"
    info "Encoding:        $(sq "$DB" 'PRAGMA encoding;')"
    info "Auto vacuum:     $(sq "$DB" 'PRAGMA auto_vacuum;')"
    info "User version:    $(sq "$DB" 'PRAGMA user_version;')"
    info "Foreign keys:    $(sq "$DB" 'PRAGMA foreign_keys;')"
    if [ -f "${DB}-wal" ]; then
        info "WAL file:        $(human "$(file_size "${DB}-wal")")"
    else
        info "WAL file:        none"
    fi
    printf "\n"
    info "Tables:          $(sq "$DB" "SELECT count(*) FROM sqlite_master WHERE type='table';")"
    info "Indexes:         $(sq "$DB" "SELECT count(*) FROM sqlite_master WHERE type='index';")"
    info "File size:       $(human "$(file_size "$DB")")"
    printf "\n"
}

cmd_tables() {
    need_db
    info "Tables in: $DB"
    printf "\n"
    sq "$DB" "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;" |
    while IFS= read -r t; do
        [ -n "$t" ] || continue
        COUNT=$(sq "$DB" "SELECT count(*) FROM $(qident "$t");")
        printf "  %-40s %s rows\n" "$t" "${COUNT:-?}"
    done
    printf "\n"
}

cmd_indexes() {
    need_db
    info "Indexes in: $DB"
    printf "\n"
    sq "$DB" "SELECT name, tbl_name FROM sqlite_master WHERE type='index' ORDER BY tbl_name, name;" |
    while IFS='|' read -r idx tbl; do
        [ -n "$idx" ] || continue
        printf "  %-40s -> %s\n" "$idx" "$tbl"
    done
    printf "\n"
}

cmd_schema() {
    need_db
    # Statements end in ";" so the output can be pasted back as SQL. For one
    # table its indexes and triggers are included too, like .schema does.
    if [ -n "$ARG3" ]; then
        info "Schema for '$ARG3' in: $DB"
        OUT=$(sq "$DB" "SELECT sql || ';' FROM sqlite_master WHERE sql IS NOT NULL AND (name=$(qstr "$ARG3") OR tbl_name=$(qstr "$ARG3")) ORDER BY type<>'table', type, name;")
        [ -n "$OUT" ] || { err "No table, view or index named '$ARG3'"; exit 1; }
        printf '%s\n' "$OUT"
    else
        info "Full schema for: $DB"
        sq "$DB" "SELECT sql || ';' FROM sqlite_master WHERE sql IS NOT NULL ORDER BY type, name;"
    fi
}

cmd_size() {
    need_db
    PAGE_SIZE=$(sq "$DB" 'PRAGMA page_size;')
    PAGE_COUNT=$(sq "$DB" 'PRAGMA page_count;')
    FREELIST=$(sq "$DB" 'PRAGMA freelist_count;')
    printf "\n"
    info "File:          $DB"
    info "File size:     $(human "$(file_size "$DB")")"
    info "Page size:     ${PAGE_SIZE} bytes"
    info "Page count:    ${PAGE_COUNT}"
    info "Freelist:      ${FREELIST} pages"
    [ -f "${DB}-wal" ] && info "WAL size:      $(human "$(file_size "${DB}-wal")")"
    [ -f "${DB}-shm" ] && info "SHM present:   yes"
    printf "\n"
}

# Replaces the sqlite3_analyzer tool, which needs TCL to build and was never
# shipped. dbstat gives the same per-object page accounting.
cmd_biggest() {
    need_db
    LIMIT="${ARG3:-10}"
    case "$LIMIT" in
        '' | *[!0-9]* | 0) LIMIT=10 ;;
    esac
    info "Largest objects in: $DB (top $LIMIT, via dbstat)"
    printf "\n"
    printf "  %-38s %10s %10s\n" "NAME" "PAGES" "SIZE"
    printf "  %-38s %10s %10s\n" "──────────────────────────────────────" "──────────" "──────────"
    # aggregate=TRUE makes dbstat return one row per object (pgsize = total
    # bytes, pageno = page count) instead of one row per page.
    OUT=$(sq "$DB" "SELECT name, pgsize, pageno FROM dbstat WHERE aggregate=TRUE ORDER BY pgsize DESC LIMIT $LIMIT;")
    if [ -z "$OUT" ]; then
        err "dbstat is unavailable — this sqlite3 was built without SQLITE_ENABLE_DBSTAT_VTAB"
        exit 1
    fi
    printf '%s\n' "$OUT" | while IFS='|' read -r name bytes pages; do
        [ -n "$name" ] || continue
        printf "  %-38s %10s %10s\n" "$name" "$pages" "$(human "$bytes")"
    done
    printf "\n"
}

# ── Maintain ──────────────────────────────────────────────────────────────────
cmd_integrity() {
    need_db
    info "Running integrity_check on: $DB"
    RESULT=$(sq "$DB" 'PRAGMA integrity_check;')
    if [ "$RESULT" = "ok" ]; then
        ok "integrity_check passed"
    else
        err "integrity_check FAILED:"
        printf '%s\n' "$RESULT"
        exit 1
    fi
}

cmd_vacuum() {
    need_db
    need_writable
    BEFORE=$(file_size "$DB")
    info "Running VACUUM on: $DB (was $(human "$BEFORE"))"
    sqw "$DB" "VACUUM;" || { err "VACUUM failed"; exit 1; }
    AFTER=$(file_size "$DB")
    ok "VACUUM complete — $(human "$BEFORE") -> $(human "$AFTER")"
}

cmd_analyze() {
    need_db
    need_writable
    info "Running ANALYZE on: $DB"
    sqw "$DB" "ANALYZE;" || { err "ANALYZE failed"; exit 1; }
    ok "ANALYZE complete"
}

cmd_optimize() {
    need_db
    need_writable
    info "Running PRAGMA optimize on: $DB"
    # analysis_limit returns its value as a row; keep it off the output.
    sqw "$DB" "PRAGMA analysis_limit=1000; PRAGMA optimize;" > /dev/null || { err "optimize failed"; exit 1; }
    ok "optimize complete"
}

cmd_wal_checkpoint() {
    need_db
    need_writable
    info "Running WAL checkpoint on: $DB"
    RESULT=$(sqw "$DB" 'PRAGMA wal_checkpoint(FULL);') || { err "wal_checkpoint failed"; exit 1; }
    # Result is busy|wal_frames|checkpointed_frames. The old version printed
    # "OK" even when busy=1, i.e. when the checkpoint could not finish.
    # The "|" must be quoted: an unquoted | is pattern alternation in mksh.
    CP_BUSY="${RESULT%%"|"*}"; _rest="${RESULT#*"|"}"
    CP_LOG="${_rest%%"|"*}";   CP_DONE="${_rest#*"|"}"
    if [ "$CP_LOG" = "-1" ]; then
        info "Not in WAL mode (journal_mode is $(sq "$DB" 'PRAGMA journal_mode;')) — nothing to checkpoint"
    elif [ "$CP_BUSY" = "1" ]; then
        warn "Checkpoint incomplete: $CP_DONE of $CP_LOG frames — another connection is using the database"
    else
        ok "Checkpointed $CP_DONE of $CP_LOG frames"
    fi
    if [ -f "${DB}-wal" ]; then
        info "WAL file: $(human "$(file_size "${DB}-wal")") (kept while another connection has the database open)"
    fi
}

# ── Move data ─────────────────────────────────────────────────────────────────
cmd_backup() {
    need_db
    [ -n "$ARG3" ] || { err "Usage: sqlite3-tool backup <source> <destination>"; exit 1; }
    DEST="$ARG3"
    # A directory as destination means "put it in there under the same name";
    # before, the temporary file ended up in the directory under its temp name.
    [ -d "$DEST" ] && DEST="${DEST%/}/$(basename "$DB")"

    # The old version started with rm -f "$DEST". With the source given twice
    # (backup app.db app.db) that deleted the database it was meant to protect,
    # and a failed backup always destroyed the previous good copy.
    if [ -e "$DEST" ] && [ "$DB" -ef "$DEST" ]; then
        err "Source and destination are the same file: $DEST"
        exit 1
    fi

    info "Backing up: $DB -> $DEST"

    # .backup uses SQLite's online backup API: safe on a live database and it
    # needs no write access to the source. Write to a temporary file next to
    # the destination and only replace the destination once the copy has
    # passed integrity_check.
    TMP="${DEST}.sqlite3-tool-$$.tmp"
    trap 'rm -f "$TMP" "${TMP}-journal" "${TMP}-wal" "${TMP}-shm"' EXIT
    trap 'exit 130' INT TERM

    if ! "$SQLITE3" -cmd ".output /dev/null" \
                    -cmd "PRAGMA busy_timeout=$BUSY_MS;" \
                    -cmd ".output stdout" \
                    "$DB" ".backup $(qdot "$TMP")"; then
        err "Backup failed — $DEST was not touched"
        exit 1
    fi

    [ -f "$TMP" ] || { err "Backup produced no file"; exit 1; }
    VERIFY=$(sq "$TMP" 'PRAGMA integrity_check;')
    if [ "$VERIFY" != "ok" ]; then
        err "Backup failed its own integrity check — $DEST was not touched"
        exit 1
    fi

    rm -f "${DEST}-wal" "${DEST}-shm" 2>/dev/null
    mv -f "$TMP" "$DEST" || { err "Could not move the backup into place: $DEST"; exit 1; }
    ok "Backup complete and verified -> $DEST ($(human "$(file_size "$DEST")"))"
}

cmd_restore() {
    [ -n "$DB" ]   || { err "Usage: sqlite3-tool restore <backup> <destination>"; exit 1; }
    [ -n "$ARG3" ] || { err "Usage: sqlite3-tool restore <backup> <destination>"; exit 1; }
    SRC="$DB"
    DEST="$ARG3"
    [ -f "$SRC" ] || { err "Backup file not found: $SRC"; exit 1; }
    [ -d "$DEST" ] && { err "Destination is a directory; give the database file path: $DEST"; exit 1; }
    if [ -e "$DEST" ] && [ "$SRC" -ef "$DEST" ]; then
        err "Backup and destination are the same file: $DEST"
        exit 1
    fi

    info "Restoring: $SRC -> $DEST"

    INTEGRITY=$(sq "$SRC" 'PRAGMA integrity_check;')
    if [ "$INTEGRITY" != "ok" ]; then
        err "Source backup failed integrity check — aborting restore"
        exit 1
    fi

    # The old version did cp and then deleted -wal/-shm next to the
    # destination. Deleting -shm under an app that still has the database open
    # corrupts it. .restore writes the pages through SQLite instead: it takes
    # the proper locks, handles WAL itself, and keeps the file's owner and
    # SELinux label, so an app database stays openable by its app.
    if ! "$SQLITE3" -cmd ".output /dev/null" \
                    -cmd "PRAGMA busy_timeout=$BUSY_MS;" \
                    -cmd ".output stdout" \
                    "$DEST" ".restore $(qdot "$SRC")"; then
        err "Restore failed (is the database busy? stop the app that owns it)"
        exit 1
    fi

    VERIFY=$(sq "$DEST" 'PRAGMA integrity_check;')
    if [ "$VERIFY" != "ok" ]; then
        err "Restored database failed integrity_check:"
        printf '%s\n' "$VERIFY"
        exit 1
    fi

    ok "Restore complete and verified -> $DEST"
}

# ── Build info ────────────────────────────────────────────────────────────────
cmd_compile_options() {
    FILTER="$DB"
    OUT=$("$SQLITE3" ":memory:" "PRAGMA compile_options;" 2>/dev/null)
    if [ -n "$FILTER" ]; then
        printf '%s\n' "$OUT" | grep -i -- "$FILTER" || { err "No compile option matches: $FILTER"; exit 1; }
    else
        printf '%s\n' "$OUT"
    fi
}

cmd_version() {
    printf "sqlite3-tool  v%s\n" "$VERSION"
    printf "sqlite3       %s\n" "$("$SQLITE3" --version 2>/dev/null)"
    printf "binary        %s\n" "$SQLITE3"
}

cmd_doctor() {
    need_db
    if command -v sqlite3-doctor >/dev/null 2>&1; then
        sqlite3-doctor "$DB"
    elif [ -x "${0%/*}/sqlite3-doctor" ]; then
        "${0%/*}/sqlite3-doctor" "$DB"
    else
        err "sqlite3-doctor not found"
        exit 1
    fi
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
case "$CMD" in
    info)            cmd_info ;;
    tables)          cmd_tables ;;
    indexes)         cmd_indexes ;;
    schema)          cmd_schema ;;
    size)            cmd_size ;;
    biggest)         cmd_biggest ;;
    integrity)       cmd_integrity ;;
    vacuum)          cmd_vacuum ;;
    analyze)         cmd_analyze ;;
    optimize)        cmd_optimize ;;
    wal-checkpoint)  cmd_wal_checkpoint ;;
    backup)          cmd_backup ;;
    restore)         cmd_restore ;;
    compile-options) cmd_compile_options ;;
    version)         cmd_version ;;
    doctor)          cmd_doctor ;;
    *)
        err "Unknown command: $CMD"
        printf "Run 'sqlite3-tool --help' for usage.\n"
        exit 1
        ;;
esac
